[[model]]
desc: """
    A single-gate Hodgkin-Huxley model of the current IKr
"""
# Initial values
ikr.O = 0

[ikr]
# Voltage-dependent transition rates
alpha = p1 * exp(p2 * membrane.V)
    in [1/ms]
beta = p3 * exp(-p4 * membrane.V)
    in [1/ms]

# Transition rate parameters
p1 = 2.1e-3 [1/ms] in [1/ms]
p2 = 7.2e-2 [1/mV] in [1/mV]
p3 = 3.5e-5 [1/ms] in [1/ms]
p4 = 6.2e-2 [1/mV] in [1/mV]

# Model ODEs
dot(O) = alpha * C - beta * O
    desc: Open state occupancy / open state probability
C = 1 - O
    desc: Closed state occupancy

# Current
IKr = g * O * (membrane.V - reversal.E)
    in [pA]
g = 0.1524 [nS]
    in [nS]
    desc: The maximum conductance

[membrane]
V = engine.pace * 1 [mV]
    desc: membrane potential
    in [mV]
    
[reversal]
R = 8314 [J/kmol/K] : Gas constant
    in [J/kmol/K]
T = 310 [K] : Temperature
    in [K]
F = 96487 [C/mol] : Faraday constant
    in [C/mol]
Ki = 140 [mM] in [mM] : Internal K+ concentration
Ko = 4 [mM] in [mM] : External K+ concentration
E = R * T / F * log(Ko / Ki)
    in [mV]

[engine]
time = 0 [ms] bind time
    in [ms]
pace = 0 bind pace

